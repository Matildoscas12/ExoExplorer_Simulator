  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: A superficie de Phobos e marcada por uma paisagem cheia de crateras de
    impacto, sugerindo uma historia de colisoes com outros corpos celestes ao longo
    do tempo. Devido a sua baixa gravidade, a forma de Phobos e irregular, o que
    contribui para uma topografia acidentada e escarpada.
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: dc36b3fdc14f47ebb36fd484a67e268a, type: 2}
