      m_Calls: []
  m_text: "Deimos tem uma orbita quase circular em torno de Marte e um eixo de inclina\xE7\xE3o
    muito pequeno. Isso resulta em uma rota\xE7ao sincrona, onde sempre apresenta
    a mesma face voltada para Marte."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: dc36b3fdc14f47ebb36fd484a67e268a, type: 2}
