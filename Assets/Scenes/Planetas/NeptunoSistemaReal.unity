      m_Calls: []
  m_text: "At\xE9 agora, nao foram detectados indicios de um campo magnetico no Plutao.
    Isso pode ser devido a falta de atividade geologica significativa na sua superficie
    ou a fatores ainda desconhecidos sobre a composicao e estrutura interna do planeta
    anao."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: dc36b3fdc14f47ebb36fd484a67e268a, type: 2}
